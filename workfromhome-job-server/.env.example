PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/workfromhome_jobs
NODE_ENV=development
BODY_LIMIT=256kb
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cron every 2 hours
CRON_SCHEDULE=0 */2 * * *
CRON_TIMEZONE=Asia/Kolkata
ALERT_DIGEST_ENABLED=true
ALERT_DIGEST_CRON_SCHEDULE=15 * * * *
ALERT_DIGEST_BATCH_SIZE=25
ALERT_DIGEST_JOB_LIMIT=12
TARGET_COUNTRIES=US,UK,DE,FR,NL,IE,ES,IT,SE,CH,NO,DK,FI,AT,BE,PT,PL,CZ,HU,RO,GR
RSS_RECENCY_DAYS=7
INGEST_ENABLE_GOOGLE_RSS=true
INGEST_ENABLE_REMOTIVE=true
INGEST_ENABLE_ARBEITNOW=true
INGEST_ENABLE_JOBICY=true
INGEST_ENABLE_REMOTEOK=true
REMOTIVE_API_URL=https://remotive.com/api/remote-jobs
ARBEITNOW_API_URL=https://www.arbeitnow.com/api/job-board-api
JOBICY_API_URL=https://jobicy.com/api/v2/remote-jobs
REMOTEOK_API_URL=https://remoteok.com/api
SOURCE_FETCH_TIMEOUT_MS=15000
ARBEITNOW_PAGES=2
JOBICY_COUNT=100

# Optional feed overrides (pattern: GOOGLE_RSS_URL_<COUNTRY_CODE>_<WFH|MIXED>)
# Example:
# GOOGLE_RSS_URL_US_WFH=https://news.google.com/rss/search?q=work+from+home+jobs+united+states+when:7d&hl=en-US&gl=US&ceid=US:en
# GOOGLE_RSS_URL_DE_WFH=https://news.google.com/rss/search?q=work+from+home+jobs+germany+when:7d&hl=de-DE&gl=DE&ceid=DE:de
GOOGLE_RSS_URL_US_WFH=https://news.google.com/rss/search?q=work+from+home+jobs+united+states+when:7d&hl=en-US&gl=US&ceid=US:en
GOOGLE_RSS_URL_UK_WFH=https://news.google.com/rss/search?q=work+from+home+jobs+uk+when:7d&hl=en-GB&gl=GB&ceid=GB:en

# Mixed feeds (20% target)
GOOGLE_RSS_URL_US_MIXED=https://news.google.com/rss/search?q=latest+tech+jobs+united+states+when:7d&hl=en-US&gl=US&ceid=US:en
GOOGLE_RSS_URL_UK_MIXED=https://news.google.com/rss/search?q=latest+tech+jobs+uk+when:7d&hl=en-GB&gl=GB&ceid=GB:en

# Ingestion controls
INGEST_MAX_JOBS_PER_RUN=10
INGEST_FRESH_HOURS=72
INGEST_TRUSTED_FRESH_HOURS=336
INGEST_WFH_RATIO=0.8
INGEST_MAX_PER_COUNTRY=4
INGEST_MAX_PER_SOURCE=4
INGEST_MIN_JOB_RELEVANCE_SCORE=2
INGEST_MIN_GOOGLE_DETAIL_CHARS=220
JOB_TTL_DAYS=15
AI_TIMEOUT_MS=15000
MAX_SEARCH_CHARS=80
ADMIN_API_KEY=
SITE_URL=https://remotejobdesk.com
RESEND_API_KEY=
EMAIL_FROM=alerts@remotejobdesk.com
EMAIL_REPLY_TO=

# Free AI Providers Support (Groq & Gemini)
# 1. Groq (Free at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini (Free at https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 3. OpenAI / NVIDIA API
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

